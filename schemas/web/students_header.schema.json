{
  "$defs": {
    "BufferView": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "float32"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "offset": {
          "description": "byte offset in the .bin file",
          "minimum": 0,
          "multipleOf": 4,
          "title": "Offset",
          "type": "integer"
        },
        "count": {
          "description": "number of elements (not bytes)",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "shape": {
          "description": "logical shape; product == count",
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "dtype",
        "offset",
        "count",
        "shape"
      ],
      "title": "BufferView",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "config_hash",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Scenario": {
      "enum": [
        "no_metro",
        "metro"
      ],
      "title": "Scenario",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``students/day-<weekday>.{json,bin}``: every leg of the day, both scenarios side by\nside, for looking at one student (their classes and how they get there).\n\nOne row = one leg, sorted by student and order in the day. ``from`` / ``to`` /\n``*_board`` / ``*_alight`` index ``keys`` (65535: none); ``kind`` indexes ``leg_kinds``;\n``*_mode`` is a MODE_CODES value. Times are seconds since 00:00 of the weekday;\n``earliest`` (the previous class ends) and ``deadline`` (the class starts) are NaN when\nthe leg has none.",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "bin": {
      "description": "file name of the .bin next to this header",
      "title": "Bin",
      "type": "string"
    },
    "buffers": {
      "additionalProperties": {
        "$ref": "#/$defs/BufferView"
      },
      "title": "Buffers",
      "type": "object"
    },
    "kind": {
      "const": "students",
      "default": "students",
      "title": "Kind",
      "type": "string"
    },
    "weekday": {
      "maximum": 5,
      "minimum": 1,
      "title": "Weekday",
      "type": "integer"
    },
    "n_students": {
      "title": "N Students",
      "type": "integer"
    },
    "keys": {
      "description": "endpoints: building, room, stop or station keys",
      "items": {
        "type": "string"
      },
      "title": "Keys",
      "type": "array"
    },
    "leg_kinds": {
      "items": {
        "type": "string"
      },
      "title": "Leg Kinds",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "title": "Scenarios",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "bin",
    "buffers",
    "kind",
    "weekday",
    "n_students",
    "keys",
    "leg_kinds",
    "scenarios"
  ],
  "title": "StudentsHeader",
  "type": "object"
}
