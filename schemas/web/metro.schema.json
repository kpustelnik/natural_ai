{
  "$defs": {
    "MetroStation": {
      "additionalProperties": false,
      "properties": {
        "building_id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
          "title": "Building Id",
          "type": "string"
        },
        "top": {
          "description": "shaft top at the main entrance",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Top",
          "type": "array"
        },
        "platform": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Platform",
          "type": "array"
        }
      },
      "required": [
        "building_id",
        "top",
        "platform"
      ],
      "title": "MetroStation",
      "type": "object"
    },
    "MetroTopology": {
      "enum": [
        "line",
        "loop"
      ],
      "title": "MetroTopology",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "generated_at",
        "generator"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RunStop": {
      "additionalProperties": false,
      "properties": {
        "station": {
          "description": "index into stations",
          "minimum": 0,
          "title": "Station",
          "type": "integer"
        },
        "arrive_t": {
          "title": "Arrive T",
          "type": "number"
        },
        "depart_t": {
          "title": "Depart T",
          "type": "number"
        }
      },
      "required": [
        "station",
        "arrive_t",
        "depart_t"
      ],
      "title": "RunStop",
      "type": "object"
    },
    "TrainRun": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "integer"
        },
        "train_id": {
          "title": "Train Id",
          "type": "integer"
        },
        "weekday": {
          "maximum": 5,
          "minimum": 1,
          "title": "Weekday",
          "type": "integer"
        },
        "direction": {
          "enum": [
            1,
            -1
          ],
          "title": "Direction",
          "type": "integer"
        },
        "stops": {
          "items": {
            "$ref": "#/$defs/RunStop"
          },
          "minItems": 2,
          "title": "Stops",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "train_id",
        "weekday",
        "direction",
        "stops"
      ],
      "title": "TrainRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "topology": {
      "$ref": "#/$defs/MetroTopology"
    },
    "stations": {
      "description": "in line order",
      "items": {
        "$ref": "#/$defs/MetroStation"
      },
      "minItems": 2,
      "title": "Stations",
      "type": "array"
    },
    "tunnel": {
      "description": "platform-level polyline through stations in order (closed for loop)",
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Tunnel",
      "type": "array"
    },
    "headway_s": {
      "title": "Headway S",
      "type": "number"
    },
    "dwell_s": {
      "title": "Dwell S",
      "type": "number"
    },
    "speed_mps": {
      "title": "Speed Mps",
      "type": "number"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/TrainRun"
      },
      "title": "Runs",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "topology",
    "stations",
    "tunnel",
    "headway_s",
    "dwell_s",
    "speed_mps",
    "runs"
  ],
  "title": "Metro",
  "type": "object"
}
