{
  "$defs": {
    "BufferView": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "float32"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "offset": {
          "description": "byte offset in the .bin file",
          "minimum": 0,
          "multipleOf": 4,
          "title": "Offset",
          "type": "integer"
        },
        "count": {
          "description": "number of elements (not bytes)",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "shape": {
          "description": "logical shape; product == count",
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "dtype",
        "offset",
        "count",
        "shape"
      ],
      "title": "BufferView",
      "type": "object"
    },
    "MetroTopology": {
      "enum": [
        "line",
        "loop"
      ],
      "title": "MetroTopology",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "config_hash",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``replays/<id>/trace.{json,bin}``: AcoTrace (results/<run_id>/trace.npz) with the\ncandidate positions and the convergence curve, for the ACO player.\n\nBuffers (I sampled iterations, A sampled ants, k stations, N candidates, C iterations):\n    iterations int32 (I)   tours int16 (I, A, k)   tour_cost_s float32 (I, A)\n    best_tour int16 (I, k)   pheromone float32 (I, N, N)\n    curve_iteration int32 (C)   curve_best_s, curve_iter_best_s, curve_iter_mean_s float32 (C)\nThe curve is convergence.csv (every iteration); without it, the sampled iterations.",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "bin": {
      "description": "file name of the .bin next to this header",
      "title": "Bin",
      "type": "string"
    },
    "buffers": {
      "additionalProperties": {
        "$ref": "#/$defs/BufferView"
      },
      "title": "Buffers",
      "type": "object"
    },
    "kind": {
      "const": "aco_trace",
      "default": "aco_trace",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "algorithm": {
      "title": "Algorithm",
      "type": "string"
    },
    "topology": {
      "$ref": "#/$defs/MetroTopology"
    },
    "k": {
      "minimum": 2,
      "title": "K",
      "type": "integer"
    },
    "n_iterations": {
      "description": "iterations of the whole run",
      "minimum": 1,
      "title": "N Iterations",
      "type": "integer"
    },
    "best_s": {
      "description": "objective of the final best line",
      "title": "Best S",
      "type": "number"
    },
    "baseline_s": {
      "description": "objective without metro",
      "title": "Baseline S",
      "type": "number"
    },
    "stations": {
      "description": "the final best line, in line order",
      "items": {
        "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
        "type": "string"
      },
      "title": "Stations",
      "type": "array"
    },
    "candidate_ids": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
        "type": "string"
      },
      "title": "Candidate Ids",
      "type": "array"
    },
    "candidate_tops": {
      "description": "shaft tops (main entrances), web",
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Candidate Tops",
      "type": "array"
    },
    "candidate_platforms": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Candidate Platforms",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "bin",
    "buffers",
    "kind",
    "run_id",
    "algorithm",
    "topology",
    "k",
    "n_iterations",
    "best_s",
    "baseline_s",
    "stations",
    "candidate_ids",
    "candidate_tops",
    "candidate_platforms"
  ],
  "title": "AcoTraceHeader",
  "type": "object"
}
