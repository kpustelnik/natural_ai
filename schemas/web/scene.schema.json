{
  "$defs": {
    "PlaceKind": {
      "enum": [
        "academic",
        "dorm",
        "other"
      ],
      "title": "PlaceKind",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "generated_at",
        "generator"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SceneBuilding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "kind": {
          "$ref": "#/$defs/PlaceKind"
        },
        "lod": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Lod",
          "type": "integer"
        },
        "glb": {
          "description": "path relative to the data dir, e.g. buildings/D-17.glb",
          "title": "Glb",
          "type": "string"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/SceneLevel"
          },
          "title": "Levels",
          "type": "array"
        },
        "bbox_min": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox Min",
          "type": "array"
        },
        "bbox_max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox Max",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "lod",
        "glb",
        "levels",
        "bbox_min",
        "bbox_max"
      ],
      "title": "SceneBuilding",
      "type": "object"
    },
    "SceneLevel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "floor_y": {
          "description": "web y of the floor",
          "title": "Floor Y",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "floor_y",
        "height"
      ],
      "title": "SceneLevel",
      "type": "object"
    },
    "SceneStop": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^stop:[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "SceneStop",
      "type": "object"
    },
    "WebFrame": {
      "additionalProperties": false,
      "properties": {
        "origin_lonlat": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Origin Lonlat",
          "type": "array"
        },
        "origin_x": {
          "description": "EPSG:2180 easting of the origin",
          "title": "Origin X",
          "type": "number"
        },
        "origin_y": {
          "description": "EPSG:2180 northing of the origin",
          "title": "Origin Y",
          "type": "number"
        },
        "origin_z": {
          "description": "absolute height mapped to web y = 0",
          "title": "Origin Z",
          "type": "number"
        },
        "axes": {
          "const": "x=east,y=up,z=-north",
          "default": "x=east,y=up,z=-north",
          "title": "Axes",
          "type": "string"
        }
      },
      "required": [
        "origin_lonlat",
        "origin_x",
        "origin_y",
        "origin_z"
      ],
      "title": "WebFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "frame": {
      "$ref": "#/$defs/WebFrame"
    },
    "buildings": {
      "items": {
        "$ref": "#/$defs/SceneBuilding"
      },
      "title": "Buildings",
      "type": "array"
    },
    "stops": {
      "items": {
        "$ref": "#/$defs/SceneStop"
      },
      "title": "Stops",
      "type": "array"
    },
    "ground_glb": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "terrain / paths mesh",
      "title": "Ground Glb"
    }
  },
  "required": [
    "provenance",
    "frame",
    "buildings",
    "stops"
  ],
  "title": "Scene",
  "type": "object"
}
