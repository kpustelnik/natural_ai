{
  "$defs": {
    "BufferView": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "float32"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "offset": {
          "description": "byte offset in the .bin file",
          "minimum": 0,
          "multipleOf": 4,
          "title": "Offset",
          "type": "integer"
        },
        "count": {
          "description": "number of elements (not bytes)",
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "shape": {
          "description": "logical shape; product == count",
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "dtype",
        "offset",
        "count",
        "shape"
      ],
      "title": "BufferView",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "config_hash",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``replays/<id>/walk.{json,bin}``: ACO level 1 (``scripts/walk_aco.py``): the peak\nwalking flows assigned with congestion, for the viewer. Edge indices are those of\n``network.json`` (matched by node keys), node indices too.\n\nBuffers (I sampled iterations, E network edges, P sampled ant paths, V their nodes,\nC iterations):\n    iterations int32 (I)   flow float32 (I, E) people per period   ratio float32 (I, E)\n    flow / capacity   pheromone float32 (I, E) 0..1   ratio_aon float32 (E)\n    ant_sample_offsets uint32 (I+1) paths of sample i   ant_offsets uint32 (P+1)\n    ant_nodes uint32 (V)   curve_iteration int32 (C)   curve_mean_s, curve_iter_mean_s,\n    curve_gap float32 (C)",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "bin": {
      "description": "file name of the .bin next to this header",
      "title": "Bin",
      "type": "string"
    },
    "buffers": {
      "additionalProperties": {
        "$ref": "#/$defs/BufferView"
      },
      "title": "Buffers",
      "type": "object"
    },
    "kind": {
      "const": "walk_trace",
      "default": "walk_trace",
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "n_iterations": {
      "minimum": 1,
      "title": "N Iterations",
      "type": "integer"
    },
    "window": {
      "description": "the peak window, e.g. 'Wednesday 09:30-09:45'",
      "title": "Window",
      "type": "string"
    },
    "period_s": {
      "title": "Period S",
      "type": "number"
    },
    "n_legs": {
      "title": "N Legs",
      "type": "integer"
    },
    "people": {
      "title": "People",
      "type": "number"
    },
    "free_flow_mean_s": {
      "description": "mean walk without congestion",
      "title": "Free Flow Mean S",
      "type": "number"
    },
    "aon_mean_s": {
      "description": "everybody on the free-flow shortest path, congested",
      "title": "Aon Mean S",
      "type": "number"
    },
    "msa_mean_s": {
      "description": "equilibrium reference (MSA)",
      "title": "Msa Mean S",
      "type": "number"
    },
    "aco_mean_s": {
      "description": "the colony's final assignment",
      "title": "Aco Mean S",
      "type": "number"
    }
  },
  "required": [
    "provenance",
    "bin",
    "buffers",
    "kind",
    "run_id",
    "n_iterations",
    "window",
    "period_s",
    "n_legs",
    "people",
    "free_flow_mean_s",
    "aon_mean_s",
    "msa_mean_s",
    "aco_mean_s"
  ],
  "title": "WalkTraceHeader",
  "type": "object"
}
