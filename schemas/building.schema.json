{
  "$defs": {
    "Corridor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "unique within the whole building",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "centreline, local metres",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Path",
          "type": "array"
        },
        "width": {
          "default": 2.5,
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "Corridor",
      "type": "object"
    },
    "Door": {
      "additionalProperties": false,
      "description": "Door from an explicitly drawn space into a corridor.",
      "properties": {
        "corridor": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Corridor",
          "type": "string"
        },
        "at": {
          "description": "metres along the corridor centreline",
          "minimum": 0,
          "title": "At",
          "type": "number"
        }
      },
      "required": [
        "corridor",
        "at"
      ],
      "title": "Door",
      "type": "object"
    },
    "Entrance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "corridor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corridor"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "start",
                "end"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "point": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "metro_shaft": {
          "default": false,
          "description": "candidate metro station lies under this entrance",
          "title": "Metro Shaft",
          "type": "boolean"
        },
        "osm_node": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "force the outdoor link to this OSM node; default = nearest",
          "title": "Osm Node"
        }
      },
      "required": [
        "id"
      ],
      "title": "Entrance",
      "type": "object"
    },
    "Level": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "elevation": {
          "description": "floor height above the anchor ground, metres",
          "title": "Elevation",
          "type": "number"
        },
        "height": {
          "default": 3.5,
          "description": "floor-to-floor height",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "footprint": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outline override for this level",
          "title": "Footprint"
        },
        "corridors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Corridor"
          },
          "title": "Corridors",
          "type": "array"
        },
        "rooms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Room"
          },
          "title": "Rooms",
          "type": "array"
        },
        "stairs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Stairs"
          },
          "title": "Stairs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "elevation"
      ],
      "title": "Level",
      "type": "object"
    },
    "PlaceKind": {
      "enum": [
        "academic",
        "dorm",
        "other"
      ],
      "title": "PlaceKind",
      "type": "string"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "description": "lon, lat of the local origin (take it from any web map)",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Anchor",
          "type": "array"
        },
        "bearing_deg": {
          "default": 90.0,
          "description": "grid bearing (EPSG:2180) of local +x: 0 = north, 90 = east (default)",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Bearing Deg",
          "type": "number"
        },
        "ground_elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "absolute ground height at the anchor; None = from DEM or 0",
          "title": "Ground Elevation M"
        }
      },
      "required": [
        "anchor"
      ],
      "title": "Placement",
      "type": "object"
    },
    "Room": {
      "additionalProperties": false,
      "properties": {
        "corridor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corridor"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "start of the box along corridor",
          "title": "At"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "extent along the corridor",
          "title": "Width"
        },
        "depth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "extent away from corridor",
          "title": "Depth"
        },
        "door_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "door offset from the box start; default = middle",
          "title": "Door At"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "explicit outline instead of a box",
          "title": "Polygon"
        },
        "doors": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Door"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doors"
        },
        "id": {
          "description": "room number as in USOS, without the building prefix",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        }
      },
      "required": [
        "id"
      ],
      "title": "Room",
      "type": "object"
    },
    "Stairs": {
      "additionalProperties": false,
      "description": "Stairwell landing on one level. Same id on several levels = one stairwell;\nconsecutive levels where it appears are connected.",
      "properties": {
        "corridor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corridor"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "start of the box along corridor",
          "title": "At"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "extent along the corridor",
          "title": "Width"
        },
        "depth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "extent away from corridor",
          "title": "Depth"
        },
        "door_at": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "door offset from the box start; default = middle",
          "title": "Door At"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "explicit outline instead of a box",
          "title": "Polygon"
        },
        "doors": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Door"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doors"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Stairs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "canonical code; must match the file name",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "kind": {
      "$ref": "#/$defs/PlaceKind",
      "default": "academic"
    },
    "aliases": {
      "default": [],
      "description": "other spellings used by USOS",
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "osm_id": {
      "anyOf": [
        {
          "pattern": "^(way|relation)/\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "OSM baseline footprint",
      "title": "Osm Id"
    },
    "residents": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "dorms only: beds, used to distribute dorm students",
      "title": "Residents"
    },
    "placement": {
      "$ref": "#/$defs/Placement"
    },
    "footprint": {
      "anyOf": [
        {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "local outline; None = take OSM footprint",
      "title": "Footprint"
    },
    "footprint_holes": {
      "default": [],
      "description": "courtyards inside the footprint (local outlines)",
      "items": {
        "items": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        "type": "array"
      },
      "title": "Footprint Holes",
      "type": "array"
    },
    "n_levels": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Levels"
    },
    "height_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height M"
    },
    "levels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Level"
      },
      "title": "Levels",
      "type": "array"
    },
    "entrances": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Entrance"
      },
      "title": "Entrances",
      "type": "array"
    }
  },
  "required": [
    "id",
    "placement"
  ],
  "title": "Building",
  "type": "object"
}
