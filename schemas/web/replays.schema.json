{
  "$defs": {
    "MetroTopology": {
      "enum": [
        "line",
        "loop"
      ],
      "title": "MetroTopology",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "config_hash",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Replay": {
      "additionalProperties": false,
      "description": "``replays/<id>/replay.json``: one thing the viewer can play back.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "aco",
            "simulation",
            "walk"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optimisation run it comes from",
          "title": "Run Id"
        },
        "topology": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetroTopology"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stations": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
            "type": "string"
          },
          "title": "Stations",
          "type": "array"
        },
        "scenarios": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "weekdays": {
          "default": [],
          "items": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "title": "Weekdays",
          "type": "array"
        },
        "files": {
          "$ref": "#/$defs/ReplayFiles"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "created_at",
        "run_id",
        "topology",
        "stations",
        "scenarios",
        "weekdays",
        "files"
      ],
      "title": "Replay",
      "type": "object"
    },
    "ReplayFiles": {
      "additionalProperties": false,
      "description": "Paths relative to the data dir; all of them live under ``replays/<id>/``.",
      "properties": {
        "metro": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Metro (metro.json)",
          "title": "Metro"
        },
        "aco_trace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AcoTraceHeader",
          "title": "Aco Trace"
        },
        "walk_trace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WalkTraceHeader (ACO level 1: walking flows with congestion)",
          "title": "Walk Trace"
        },
        "trips": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "scenario -> dir with paths.json and day-<weekday>.json",
          "propertyNames": {
            "$ref": "#/$defs/Scenario"
          },
          "title": "Trips",
          "type": "object"
        },
        "stats": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stats",
          "title": "Stats"
        },
        "students": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dir with day-<weekday>.json (StudentsHeader): who goes where",
          "title": "Students"
        }
      },
      "required": [
        "metro",
        "aco_trace",
        "walk_trace",
        "trips",
        "stats",
        "students"
      ],
      "title": "ReplayFiles",
      "type": "object"
    },
    "Scenario": {
      "enum": [
        "no_metro",
        "metro"
      ],
      "title": "Scenario",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``replays/index.json``: every replay.json found, newest first.",
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "replays": {
      "items": {
        "$ref": "#/$defs/Replay"
      },
      "title": "Replays",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "replays"
  ],
  "title": "ReplayCatalog",
  "type": "object"
}
