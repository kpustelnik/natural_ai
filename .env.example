# Skopiuj do .env, jeśli potrzebujesz. Plik .env NIE trafia do repo.
# 01_fetch_usos.py korzysta tylko z publicznego USOS API (metody anonimowe) i katalogu
# USOSweb, więc kluczy USOS nie potrzeba. Klucz konsumenta (apps.usos.agh.edu.pl/developers)
# przyda się dopiero dla metod wymagających podpisu, np. services/tt/room.
USOS_BASE_URL=https://apps.usos.agh.edu.pl
USOS_CONSUMER_KEY=
USOS_CONSUMER_SECRET=
