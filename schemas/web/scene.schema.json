{
  "$defs": {
    "BuildingFrame": {
      "additionalProperties": false,
      "description": "The building's local frame in web coordinates. local -> web:\n``web = anchor + x * (sin b, 0, -cos b) + y * (-cos b, 0, -sin b)`` with b = bearing.",
      "properties": {
        "anchor": {
          "description": "web position of the local origin (ground level)",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Anchor",
          "type": "array"
        },
        "bearing_deg": {
          "description": "grid bearing of local +x (EPSG:2180 = web grid)",
          "title": "Bearing Deg",
          "type": "number"
        }
      },
      "required": [
        "anchor",
        "bearing_deg"
      ],
      "title": "BuildingFrame",
      "type": "object"
    },
    "Extent": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Min",
          "type": "array"
        },
        "max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Max",
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Extent",
      "type": "object"
    },
    "PlaceKind": {
      "enum": [
        "academic",
        "dorm",
        "other"
      ],
      "title": "PlaceKind",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Attached to every generated JSON file, so stale outputs can be detected.",
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_at": {
          "description": "ISO 8601 timestamp",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "description": "script that produced the file, e.g. 04_optimize.py",
          "title": "Generator",
          "type": "string"
        },
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256 of the resolved config",
          "title": "Config Hash"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        }
      },
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "config_hash",
        "git_commit"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SceneAerial": {
      "additionalProperties": false,
      "description": "Orthophoto draped on the ground: an axis-aligned rectangle in the web frame.",
      "properties": {
        "image": {
          "description": "path relative to the data dir, e.g. campus/aerial.jpg",
          "title": "Image",
          "type": "string"
        },
        "min": {
          "description": "web corner with the smallest x and z",
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Min",
          "type": "array"
        },
        "max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Max",
          "type": "array"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "image",
        "min",
        "max",
        "attribution"
      ],
      "title": "SceneAerial",
      "type": "object"
    },
    "SceneBuilding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "kind": {
          "$ref": "#/$defs/PlaceKind"
        },
        "category": {
          "description": "kind, with connectors (P-…) told apart",
          "enum": [
            "academic",
            "dorm",
            "other",
            "connector"
          ],
          "title": "Category",
          "type": "string"
        },
        "lod": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Lod",
          "type": "integer"
        },
        "glb": {
          "description": "path relative to the data dir, e.g. buildings/D-17.glb",
          "title": "Glb",
          "type": "string"
        },
        "info": {
          "description": "BuildingInfo path, e.g. buildings/D-17.json",
          "title": "Info",
          "type": "string"
        },
        "yaml": {
          "description": "source file relative to the repo root",
          "title": "Yaml",
          "type": "string"
        },
        "osm_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Osm Id"
        },
        "height_m": {
          "title": "Height M",
          "type": "number"
        },
        "frame": {
          "$ref": "#/$defs/BuildingFrame"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/SceneLevel"
          },
          "title": "Levels",
          "type": "array"
        },
        "entrances": {
          "items": {
            "$ref": "#/$defs/SceneEntrance"
          },
          "title": "Entrances",
          "type": "array"
        },
        "bbox_min": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox Min",
          "type": "array"
        },
        "bbox_max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox Max",
          "type": "array"
        },
        "rooms": {
          "default": [],
          "description": "room ids (LOD3), for the search",
          "items": {
            "type": "string"
          },
          "title": "Rooms",
          "type": "array"
        },
        "n_issues": {
          "default": 0,
          "title": "N Issues",
          "type": "integer"
        },
        "stale": {
          "default": false,
          "description": "the YAML fails validation; these files are the last good ones",
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "lod",
        "glb",
        "info",
        "yaml",
        "osm_id",
        "height_m",
        "frame",
        "levels",
        "entrances",
        "bbox_min",
        "bbox_max",
        "rooms",
        "n_issues",
        "stale"
      ],
      "title": "SceneBuilding",
      "type": "object"
    },
    "SceneContext": {
      "additionalProperties": false,
      "properties": {
        "glb": {
          "description": "all context buildings merged, e.g. campus/context.glb",
          "title": "Glb",
          "type": "string"
        },
        "features": {
          "description": "ContextFeatures path, e.g. campus/context.json",
          "title": "Features",
          "type": "string"
        }
      },
      "required": [
        "glb",
        "features"
      ],
      "title": "SceneContext",
      "type": "object"
    },
    "SceneEntrance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "main": {
          "title": "Main",
          "type": "boolean"
        },
        "metro_shaft": {
          "title": "Metro Shaft",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "position",
        "main",
        "metro_shaft"
      ],
      "title": "SceneEntrance",
      "type": "object"
    },
    "SceneLevel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "floor_y": {
          "description": "web y of the floor",
          "title": "Floor Y",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "id",
        "floor_y",
        "height"
      ],
      "title": "SceneLevel",
      "type": "object"
    },
    "SceneStop": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^stop:[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "position": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "position"
      ],
      "title": "SceneStop",
      "type": "object"
    },
    "WebFrame": {
      "additionalProperties": false,
      "properties": {
        "origin_lonlat": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          ],
          "title": "Origin Lonlat",
          "type": "array"
        },
        "origin_x": {
          "description": "EPSG:2180 easting of the origin",
          "title": "Origin X",
          "type": "number"
        },
        "origin_y": {
          "description": "EPSG:2180 northing of the origin",
          "title": "Origin Y",
          "type": "number"
        },
        "origin_z": {
          "description": "absolute height mapped to web y = 0",
          "title": "Origin Z",
          "type": "number"
        },
        "axes": {
          "const": "x=east,y=up,z=-north",
          "default": "x=east,y=up,z=-north",
          "title": "Axes",
          "type": "string"
        }
      },
      "required": [
        "origin_lonlat",
        "origin_x",
        "origin_y",
        "origin_z",
        "axes"
      ],
      "title": "WebFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "frame": {
      "$ref": "#/$defs/WebFrame"
    },
    "extent": {
      "$ref": "#/$defs/Extent",
      "description": "downloaded area (bbox), for the camera and the ground"
    },
    "source_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "absolute repo path on the machine that exported (dev links)",
      "title": "Source Root"
    },
    "buildings": {
      "items": {
        "$ref": "#/$defs/SceneBuilding"
      },
      "title": "Buildings",
      "type": "array"
    },
    "stops": {
      "description": "stops used by the simulation (campus.yaml)",
      "items": {
        "$ref": "#/$defs/SceneStop"
      },
      "title": "Stops",
      "type": "array"
    },
    "other_stops": {
      "default": [],
      "description": "OSM stops not in campus.yaml",
      "items": {
        "$ref": "#/$defs/SceneStop"
      },
      "title": "Other Stops",
      "type": "array"
    },
    "ground_glb": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ground, paths, boundary, fences",
      "title": "Ground Glb"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "network": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "NetworkHeader path",
      "title": "Network"
    },
    "issues": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "IssueList path",
      "title": "Issues"
    },
    "replays": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ReplayCatalog path",
      "title": "Replays"
    },
    "aerial": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneAerial"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "provenance",
    "frame",
    "extent",
    "source_root",
    "buildings",
    "stops",
    "other_stops",
    "ground_glb",
    "context",
    "network",
    "issues",
    "replays",
    "aerial"
  ],
  "title": "Scene",
  "type": "object"
}
